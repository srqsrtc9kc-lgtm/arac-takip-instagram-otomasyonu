import type { SupabaseClient } from '@supabase/supabase-js';
import type { ContentType } from '../types';
import { TOPICS, type TopicTemplate } from './topics';
import { findForbiddenPhrase } from './language';
import { aiGenerateFields, isAiEnabled } from './ai';
import { agentLog } from '../log';

/**
 * İÇERİK ÜRETİCİ — Adım 4
 *
 * Kurallar:
 * 1. Üretilen her taslak 'draft' durumuyla kaydedilir → onaysız paylaşım yok.
 * 2. Kullanılan konular DB'de topic_id ile izlenir; havuz bitmeden
 *    aynı konu tekrar seçilmez. Havuz biterse en eski kullanılan konu döner.
 * 3. "Otomatik" modda içerik türü haftalık ritme göre belirlenir.
 */

export type GenerateMode = 'auto' | ContentType;

export const GENERATE_MODES: GenerateMode[] = [
  'auto',
  'post',
  'carousel',
  'story',
  'reels',
  'demo',
];

/** Vercel UTC'de çalışsa da içerik günü Türkiye saatine göre belirlenir. */
export function istanbulDateKey(date: Date = new Date()): string {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Istanbul',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(date);
  const get = (type: Intl.DateTimeFormatPartTypes) =>
    parts.find((part) => part.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')}`;
}

// Haftalık satış ritmi:
// Pzt carousel, Sal post, Çar reels, Per story, Cum reels, Cmt/Paz story.
export function pickTypeForToday(date: Date = new Date()): ContentType {
  const weekday = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Istanbul',
    weekday: 'short',
  }).format(date);
  switch (weekday) {
    case 'Mon':
      return 'carousel';
    case 'Tue':
      return 'post';
    case 'Wed':
    case 'Fri':
      return 'reels';
    case 'Thu':
    case 'Sat':
    case 'Sun':
      return 'story';
    default:
      return 'post';
  }
}

/**
 * Konu seçer:
 * - Önce istenen türdeki HİÇ kullanılmamış konulardan rastgele biri.
 * - Tümü kullanıldıysa, en uzun süredir kullanılmayan konu.
 */
export async function pickTopic(
  db: SupabaseClient,
  mode: GenerateMode
): Promise<TopicTemplate> {
  const type: ContentType = mode === 'auto' ? pickTypeForToday() : mode;

  // Konu kullanım geçmişi: topic_id → en son kullanım zamanı
  const { data, error } = await db
    .from('content_drafts')
    .select('topic_id, created_at')
    .not('topic_id', 'is', null)
    .order('created_at', { ascending: false });

  if (error) {
    throw new Error('Konu geçmişi okunamadı: ' + error.message);
  }

  const lastUsed = new Map<string, string>();
  for (const row of data ?? []) {
    const id = row.topic_id as string | null;
    if (id && !lastUsed.has(id)) {
      lastUsed.set(id, row.created_at as string);
    }
  }

  let candidates = TOPICS.filter((t) => t.type === type);
  if (candidates.length === 0) candidates = TOPICS; // güvenlik ağı

  const unused = candidates.filter((t) => !lastUsed.has(t.id));
  if (unused.length > 0) {
    return unused[Math.floor(Math.random() * unused.length)];
  }

  // Hepsi kullanılmış → en eski kullanılan başa gelsin
  const sorted = [...candidates].sort((a, b) => {
    const ta = lastUsed.get(a.id) ?? '';
    const tb = lastUsed.get(b.id) ?? '';
    return ta < tb ? -1 : ta > tb ? 1 : 0;
  });
  return sorted[0];
}

/**
 * Yeni taslak üretir ve 'draft' durumuyla kaydeder.
 * Dönen taslak dashboard'da ön izlemeye düşer; paylaşım için onay şarttır.
 *
 * ÜRETİM SIRASI:
 * 1) ANTHROPIC_API_KEY doluysa → Claude ile ÖZGÜN metin (lib/content/ai.ts).
 * 2) Anahtar yoksa VEYA Claude üretimi başarısız olursa → hazır konu
 *    havuzu (aşağıdaki pickTopic). Panel hiçbir durumda kırılmaz;
 *    düşüş yaşanırsa agent_logs'a yazılır.
 */
export async function generateDraft(
  db: SupabaseClient,
  mode: GenerateMode,
  scheduledFor: string | null = null
): Promise<{ id: string; topicId: string; contentType: ContentType; source: 'ai' | 'pool' }> {
  const type: ContentType = mode === 'auto' ? pickTypeForToday() : mode;

  // ── 1) Yapay zekâ üretimi (varsa) ──
  if (isAiEnabled()) {
    try {
      const f = await aiGenerateFields(db, type);
      // aiGenerateFields dil denetiminden geçmiş metin döndürür.
      const { data, error } = await db
        .from('content_drafts')
        .insert({
          content_type: type,
          goal: f.goal,
          visual_text: f.visual_text,
          visual_subtext: f.visual_subtext,
          caption: f.caption,
          cta: f.cta,
          hashtags: f.hashtags,
          story_texts: f.story_texts,
          carousel_slides: f.carousel_slides,
          reels_script: f.reels_script,
          reels_scenes: f.reels_scenes,
          topic_id: `ai-${Date.now()}`,
          scheduled_for: scheduledFor,
          status: 'draft', // KRİTİK: üretilen içerik her zaman onay bekler
        })
        .select('id')
        .single();
      if (error || !data) {
        throw new Error('Taslak kaydedilemedi: ' + (error?.message ?? 'bilinmeyen hata'));
      }
      return { id: data.id as string, topicId: 'ai', contentType: type, source: 'ai' };
    } catch (e) {
      // AI başarısız → hazır havuza güvenli düşüş (panel kırılmaz)
      await agentLog(db, 'ai_generation_fallback', 'Claude üretimi başarısız, hazır havuza dönüldü', {
        reason: (e instanceof Error ? e.message : 'bilinmeyen').slice(0, 300),
        type,
      });
    }
  }

  // ── 2) Hazır konu havuzu ──
  const topic = await pickTopic(db, mode);

  // DİL KURALI DENETİMİ: yasaklı ifade içeren içerik ÜRETİLMEZ.
  // Havuz elle yazıldığı için normalde tetiklenmez; yeni konu eklenirse
  // güvenlik ağı olarak durur.
  const forbidden = findForbiddenPhrase([
    topic.visual_text,
    topic.visual_subtext,
    topic.caption,
    topic.cta,
    ...(topic.story_texts ?? []),
    ...(topic.carousel_slides ?? []),
    topic.reels_script,
    ...(topic.reels_scenes ?? []),
  ]);
  if (forbidden) {
    await agentLog(db, 'generate_blocked_language', 'Dil kuralı ihlali: taslak oluşturulmadı', {
      topicId: topic.id,
      phrase: forbidden,
    });
    throw new Error(
      `Dil kuralı ihlali: "${forbidden}" ifadesi marka dilinde yasaklı. Taslak oluşturulmadı; lib/content/topics.ts içindeki konuyu düzeltin.`
    );
  }

  const { data, error } = await db
    .from('content_drafts')
    .insert({
      content_type: topic.type,
      goal: topic.goal,
      visual_text: topic.visual_text,
      visual_subtext: topic.visual_subtext,
      caption: topic.caption,
      cta: topic.cta,
      hashtags: topic.hashtags,
      story_texts: topic.story_texts,
      carousel_slides: topic.carousel_slides,
      reels_script: topic.reels_script,
      reels_scenes: topic.reels_scenes,
      topic_id: topic.id,
      scheduled_for: scheduledFor,
      status: 'draft', // KRİTİK: üretilen içerik her zaman onay bekler
    })
    .select('id')
    .single();

  if (error || !data) {
    throw new Error('Taslak kaydedilemedi: ' + (error?.message ?? 'bilinmeyen hata'));
  }

  return { id: data.id as string, topicId: topic.id, contentType: topic.type, source: 'pool' };
}
